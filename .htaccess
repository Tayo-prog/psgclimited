DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /index.html -> / (canonical homepage URL)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # /page.html -> /page (strip .html from the address bar)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s([^.]+)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # Serve the matching .html file for clean, extensionless URLs
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
